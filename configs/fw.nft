# fw.nft - firewall rules for the network segmentation lab
# Load into the fw namespace: sudo ip netns exec fw nft -f configs/fw.nft

# Remove our own table if it exists so the file can be reloaded safely.
# Other tables are left untouched.
table inet segmentering
delete table inet segmentering

table inet segmentering {
    chain forward {
        # Traffic passing THROUGH the firewall between zones. Default: drop.
        type filter hook forward priority 0; policy drop;

        # Replies to connections that were already allowed
        ct state established,related accept
        ct state invalid drop

        # staff -> servers: file sharing (SMB)
        iifname "fw-ansatte" oifname "fw-servere" tcp dport 445 ct state new accept

        # staff -> DMZ: web traffic
        iifname "fw-ansatte" oifname "fw-dmz" tcp dport { 80, 443 } ct state new accept

        # Anything reaching this point is not allowed: count and drop
        counter drop
    }
}
